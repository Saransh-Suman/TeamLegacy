{
  "name": "ev-pricing-tracker",
  "private": true,
  "workspaces": [
    "scraper",
    "server",
    "client"
  ],
  "scripts": {
    "scraper": "npm run start --workspace=scraper",
    "server": "npm run dev --workspace=server",
    "client": "npm run dev --workspace=client",
    "dev": "concurrently \"npm run server\" \"npm run client\""
  },
  "devDependencies": {
    "concurrently": "^8.0.0"
  }
}
